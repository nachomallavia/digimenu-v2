---
/**
 * Owner DigiMenu panel chrome (`/app/*` authenticated).
 * Always DigiMenu brand — restaurant menu theme does not apply here.
 * No View Transitions (parity with legacy perceived-perf choice).
 */
import { actions } from "astro:actions";
import Root from "./Root.astro";
import AppSidebar from "@/components/app/AppSidebar.astro";
import { Button } from "@/components/starwind/button";
import {
	SidebarInset,
	SidebarProvider,
	SidebarTrigger,
} from "@/components/starwind/sidebar";
import { COLOR_MODE_COOKIE, parseColorMode } from "@/lib/domain";

interface Props {
	title: string;
	email?: string | null;
	/** URL slug for /m/{restaurant} */
	restaurantSlug?: string | null;
	restaurantName?: string | null;
}

const { title, email, restaurantSlug, restaurantName } = Astro.props;
const currentPath = Astro.url.pathname;

const SIDEBAR_COOKIE = "digimenu_sidebar_open";
const sidebarOpen = Astro.cookies.get(SIDEBAR_COOKIE)?.value !== "false";
const colorMode = parseColorMode(Astro.cookies.get(COLOR_MODE_COOKIE)?.value);
---

<Root title={title} colorMode={colorMode}>
	<SidebarProvider class="min-h-svh" defaultOpen={sidebarOpen} cookieName={SIDEBAR_COOKIE}>
		<AppSidebar
			currentPath={currentPath}
			defaultOpen={sidebarOpen}
			colorMode={colorMode}
			restaurantName={restaurantName}
		/>
		<SidebarInset>
			<header
				class="flex h-14 shrink-0 items-center justify-between gap-3 border-b border-border px-4"
			>
				<div class="flex min-w-0 items-center gap-2">
					<SidebarTrigger />
					<div class="min-w-0">
						<p class="truncate text-sm font-medium" data-owner-restaurant-name>
							{restaurantName ?? "Panel"}
						</p>
						{email && <p class="truncate text-xs text-muted-foreground">{email}</p>}
					</div>
				</div>
				<div class="flex shrink-0 items-center gap-2">
					{
						restaurantSlug && (
							<Button
								href={`/m/${restaurantSlug}`}
								variant="primary"
								size="sm"
								target="_blank"
								rel="noopener noreferrer"
							>
								Ver menú
							</Button>
						)
					}
					<form method="POST" action={actions.auth.signOut}>
						<Button type="submit" variant="ghost" size="sm">
							Salir
						</Button>
					</form>
				</div>
			</header>
			<main class="flex-1 px-4 py-6 md:px-6">
				<slot />
			</main>
		</SidebarInset>
	</SidebarProvider>
</Root>
