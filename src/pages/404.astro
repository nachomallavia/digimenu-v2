---
import Root from "@/layouts/Root.astro";
---

<Root title="No encontrado">
	<main class="mx-auto max-w-lg px-6 py-16 text-center">
		<h1 class="text-2xl font-semibold tracking-tight">Página no encontrada</h1>
		<p class="text-muted-foreground mt-2">
			El restaurante o menú que buscás no existe o no está disponible.
		</p>
		<p class="mt-6">
			<a href="/" class="text-primary underline-offset-4 hover:underline">Volver al inicio</a>
		</p>
	</main>
</Root>
