---
import { actions } from "astro:actions";
import Dashboard from "@/layouts/Dashboard.astro";
import ProductoFormFields from "@/components/app/ProductoFormFields.astro";
import { Button } from "@/components/starwind/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/starwind/card";
import { requireOwner } from "@/lib/server/auth";
import {
	listCategoriesByRestaurant,
	listMenusByRestaurant,
	listTagsByRestaurant,
} from "@/lib/server/db";

const result = Astro.getActionResult(actions.products.create);
if (result && !result.error && result.data?.id) {
	return Astro.redirect(`/app/productos/${result.data.id}`);
}

const signOutResult = Astro.getActionResult(actions.auth.signOut);
if (signOutResult && !signOutResult.error) {
	return Astro.redirect("/app/login");
}

const auth = await requireOwner(Astro);
if (auth instanceof Response) return auth;
const { restaurant, email } = auth;

const [categories, tags, menus] = await Promise.all([
	listCategoriesByRestaurant(Astro.locals.supabase, restaurant.id),
	listTagsByRestaurant(Astro.locals.supabase, restaurant.id),
	listMenusByRestaurant(Astro.locals.supabase, restaurant.id),
]);

const defaultMenuIds = menus.length === 1 ? [menus[0]!.id] : [];
const error = result?.error?.message ?? null;
---

<Dashboard
	title="DigiMenu — Nuevo producto"
	email={email}
	restaurantSlug={restaurant.slug}
	restaurantName={restaurant.name}
>
	<div class="mx-auto flex max-w-2xl flex-col gap-6">
		<div>
			<p class="mb-1 text-sm">
				<a href="/app/productos" class="text-muted-foreground hover:text-foreground">
					← Productos
				</a>
			</p>
			<h1 class="text-2xl font-semibold tracking-tight">Nuevo producto</h1>
			<p class="text-muted-foreground">Creá un ítem del menú de tu restaurante.</p>
		</div>

		{error && <p class="text-sm text-error-foreground" role="alert">{error}</p>}

		<Card>
			<CardHeader>
				<CardTitle>Datos</CardTitle>
				<CardDescription>Nombre, precio, categoría, menús, etiquetas e imagen.</CardDescription>
			</CardHeader>
			<CardContent>
				<form
					method="POST"
					action={actions.products.create}
					enctype="multipart/form-data"
					class="flex flex-col gap-4"
				>
					<ProductoFormFields
						name=""
						price=""
						description=""
						categories={categories}
						selectedCategoryId={null}
						menus={menus}
						selectedMenuIds={defaultMenuIds}
						tags={tags}
						selectedTagIds={[]}
						available={true}
						active={true}
					/>

					<div class="flex flex-wrap gap-2">
						<Button type="submit" variant="primary">Crear producto</Button>
						<Button href="/app/productos" variant="outline">Cancelar</Button>
					</div>
				</form>
			</CardContent>
		</Card>
	</div>
</Dashboard>
