---
import { actions } from "astro:actions";
import Dashboard from "@/layouts/Dashboard.astro";
import ProductosEditor from "@/components/app/ProductosEditor.astro";
import { requireOwner } from "@/lib/server/auth";
import {
	listCategoriesByRestaurant,
	listProductsByRestaurant,
} from "@/lib/server/db";

const batchResult = Astro.getActionResult(actions.products.batchUpdate);
const deleteResult =
	Astro.getActionResult(actions.products.delete) ||
	Astro.getActionResult(actions.products.deleteJson);

const signOutResult = Astro.getActionResult(actions.auth.signOut);
if (signOutResult && !signOutResult.error) {
	return Astro.redirect("/app/login");
}

const auth = await requireOwner(Astro);
if (auth instanceof Response) return auth;
const { restaurant, email } = auth;

const [products, categories] = await Promise.all([
	listProductsByRestaurant(Astro.locals.supabase, restaurant.id),
	listCategoriesByRestaurant(Astro.locals.supabase, restaurant.id),
]);

const categoriaIdsJson = JSON.stringify(categories.map((c) => c.id));

const actionError =
	batchResult?.error?.message || deleteResult?.error?.message || null;
const message =
	deleteResult && !deleteResult.error
		? "Producto eliminado."
		: batchResult && !batchResult.error
			? "Cambios guardados."
			: null;
---

<Dashboard
	title="DigiMenu — Productos"
	email={email}
	restaurantSlug={restaurant.slug}
	restaurantName={restaurant.name}
>
	{message && <p class="mx-auto mb-4 max-w-full text-sm text-success">{message}</p>}
	{
		actionError && (
			<p class="mx-auto mb-4 max-w-full text-sm text-error-foreground" role="alert">
				{actionError}
			</p>
		)
	}
	<ProductosEditor
		products={products}
		categories={categories}
		categoriaIdsJson={categoriaIdsJson}
	/>
</Dashboard>

<script>
	import { bootProductosEditor } from "@/lib/client/owner";

	bootProductosEditor();
	document.addEventListener("astro:page-load", bootProductosEditor);
</script>
