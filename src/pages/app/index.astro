---
import { actions } from "astro:actions";
import Dashboard from "@/layouts/Dashboard.astro";
import { requireOwner } from "@/lib/server/auth";

const signOutResult = Astro.getActionResult(actions.auth.signOut);
if (signOutResult && !signOutResult.error) {
	return Astro.redirect("/app/login");
}

const auth = await requireOwner(Astro);
if (auth instanceof Response) return auth;
const { restaurant, email } = auth;
---

<Dashboard
	title="DigiMenu — Resumen"
	email={email}
	restaurantSlug={restaurant.slug}
	restaurantName={restaurant.name}
>
	<div class="mx-auto flex max-w-4xl flex-col gap-4">
		<div>
			<h1 class="text-2xl font-semibold tracking-tight">Resumen</h1>
			<p class="text-muted-foreground">
				{restaurant.name}
				<span class="text-muted-foreground/80"> · </span>
				<code class="text-sm">/m/{restaurant.slug}</code>
			</p>
		</div>
		<p class="text-muted-foreground text-sm">
			Panel del restaurante. El CRUD de menús y productos llega en los próximos tickets de Phase 2.
		</p>
		{
			signOutResult?.error && (
				<p class="text-sm text-error-foreground" role="alert">
					{signOutResult.error.message}
				</p>
			)
		}
	</div>
</Dashboard>
