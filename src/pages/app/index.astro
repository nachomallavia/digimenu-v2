---
import { actions } from "astro:actions";
import Dashboard from "@/layouts/Dashboard.astro";
import MenuQr from "@/components/app/MenuQr.astro";
import { Button } from "@/components/starwind/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/starwind/card";
import { requireOwner } from "@/lib/server/auth";
import {
	listCategoriesByRestaurant,
	listMenusByRestaurant,
	listProductsByRestaurant,
	listTagsByRestaurant,
} from "@/lib/server/db";

const signOutResult = Astro.getActionResult(actions.auth.signOut);
if (signOutResult && !signOutResult.error) {
	return Astro.redirect("/app/login");
}

const auth = await requireOwner(Astro);
if (auth instanceof Response) return auth;
const { restaurant, email } = auth;

const publicMenuUrl = new URL(`/m/${restaurant.slug}`, Astro.url.origin).href;

const [products, categories, menus, tags] = await Promise.all([
	listProductsByRestaurant(Astro.locals.supabase, restaurant.id),
	listCategoriesByRestaurant(Astro.locals.supabase, restaurant.id),
	listMenusByRestaurant(Astro.locals.supabase, restaurant.id),
	listTagsByRestaurant(Astro.locals.supabase, restaurant.id),
]);

const cards = [
	{
		title: "Productos",
		description: "Publicados en tu menú",
		count: products.length,
		manageHref: "/app/productos",
		createHref: "/app/productos/new",
	},
	{
		title: "Categorías",
		description: "Secciones del menú",
		count: categories.length,
		manageHref: "/app/categorias",
		createHref: "/app/categorias/new",
	},
	{
		title: "Menús",
		description: "Cartas públicas del restaurante",
		count: menus.length,
		manageHref: "/app/menus",
		createHref: "/app/menus/new",
	},
	{
		title: "Etiquetas",
		description: "Filtros y dietas",
		count: tags.length,
		manageHref: "/app/etiquetas",
		createHref: "/app/etiquetas/new",
	},
] as const;
---

<Dashboard
	title="DigiMenu — Resumen"
	email={email}
	restaurantSlug={restaurant.slug}
	restaurantName={restaurant.name}
>
	<div class="mx-auto flex max-w-4xl flex-col gap-6">
		<div>
			<h1 class="text-2xl font-semibold tracking-tight">Resumen</h1>
			<p class="text-muted-foreground">
				{restaurant.name}
				<span class="text-muted-foreground/80"> · </span>
				<code class="text-sm">/m/{restaurant.slug}</code>
			</p>
		</div>

		{
			signOutResult?.error && (
				<p class="text-sm text-error-foreground" role="alert">
					{signOutResult.error.message}
				</p>
			)
		}

		<Card>
			<CardHeader>
				<CardTitle>Código QR</CardTitle>
				<CardDescription>
					Imprimí o compartí el QR de la landing pública del restaurante.
				</CardDescription>
			</CardHeader>
			<CardContent>
				<MenuQr
					url={publicMenuUrl}
					filename={`${restaurant.slug}-qr.png`}
					label="Landing del restaurante"
				/>
			</CardContent>
		</Card>

		<div class="grid gap-4 sm:grid-cols-2">
			{
				cards.map((card) => (
					<Card>
						<CardHeader>
							<CardTitle>{card.title}</CardTitle>
							<CardDescription>{card.description}</CardDescription>
						</CardHeader>
						<CardContent class="flex flex-wrap items-end justify-between gap-4">
							<p class="text-3xl font-semibold tabular-nums">{card.count}</p>
							<div class="flex flex-wrap gap-2">
								<Button href={card.manageHref} variant="outline" size="sm">
									Gestionar
								</Button>
								<Button href={card.createHref} size="sm">
									Crear nuevo
								</Button>
							</div>
						</CardContent>
					</Card>
				))
			}
		</div>
	</div>
</Dashboard>

<script>
	import { prefetch } from "astro:prefetch";
	import { bindMenuQr } from "@/lib/client/owner";

	function prefetchPanelRoutes() {
		const routes = [
			"/app/productos",
			"/app/categorias",
			"/app/menus",
			"/app/etiquetas",
			"/app/info",
		];
		const run = () => {
			for (const href of routes) prefetch(href);
		};
		if ("requestIdleCallback" in window) {
			requestIdleCallback(run, { timeout: 2000 });
		} else {
			setTimeout(run, 300);
		}
	}

	function bind() {
		bindMenuQr();
		prefetchPanelRoutes();
	}
	bind();
	document.addEventListener("astro:page-load", bind);
</script>
