---
import { actions } from "astro:actions";
import Dashboard from "@/layouts/Dashboard.astro";
import CategoryIconField from "@/components/app/CategoryIconField.astro";
import { Button } from "@/components/starwind/button";
import { Input } from "@/components/starwind/input";
import { Label } from "@/components/starwind/label";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/starwind/card";
import { TAG_NAME_SUGGESTIONS } from "@/lib/domain";
import { requireOwner } from "@/lib/server/auth";

const result = Astro.getActionResult(actions.tags.create);
if (result && !result.error) {
	return Astro.redirect("/app/etiquetas");
}

const signOutResult = Astro.getActionResult(actions.auth.signOut);
if (signOutResult && !signOutResult.error) {
	return Astro.redirect("/app/login");
}

const auth = await requireOwner(Astro);
if (auth instanceof Response) return auth;
const { restaurant, email } = auth;

const error = result?.error?.message ?? null;
---

<Dashboard
	title="DigiMenu — Nueva etiqueta"
	email={email}
	restaurantSlug={restaurant.slug}
	restaurantName={restaurant.name}
>
	<div class="mx-auto flex max-w-2xl flex-col gap-6">
		<div>
			<p class="mb-1 text-sm">
				<a href="/app/etiquetas" class="text-muted-foreground hover:text-foreground">
					← Etiquetas
				</a>
			</p>
			<h1 class="text-2xl font-semibold tracking-tight">Nueva etiqueta</h1>
			<p class="text-muted-foreground">Solo para este restaurante. Luego asignala a productos.</p>
		</div>

		{error && <p class="text-sm text-error-foreground" role="alert">{error}</p>}

		<Card data-etiqueta-new>
			<CardHeader>
				<CardTitle>Datos</CardTitle>
				<CardDescription>Nombre e icono opcional.</CardDescription>
			</CardHeader>
			<CardContent>
				<form method="POST" action={actions.tags.create} class="flex flex-col gap-5">
					<div class="flex flex-col gap-1.5">
						<Label for="name">Nombre</Label>
						<Input id="name" name="name" required data-tag-nombre />
						<div class="flex flex-wrap gap-1.5 pt-1">
							{
								TAG_NAME_SUGGESTIONS.map((s) => (
									<button
										type="button"
										class="rounded-md border border-border px-2 py-0.5 text-xs text-muted-foreground hover:text-foreground"
										data-suggest={s}
									>
										{s}
									</button>
								))
							}
						</div>
					</div>
					<CategoryIconField iconValue="" />
					<div>
						<Button type="submit" variant="primary">Crear etiqueta</Button>
					</div>
				</form>
			</CardContent>
		</Card>
	</div>
</Dashboard>

<script>
	import { bindIconPreview, bindSuggestChips } from "@/lib/client/owner";

	function bind() {
		bindSuggestChips("[data-tag-nombre]");
		const root = document.querySelector<HTMLElement>("[data-etiqueta-new]");
		if (root) bindIconPreview(root);
	}
	bind();
	document.addEventListener("astro:page-load", bind);
</script>
