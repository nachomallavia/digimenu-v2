---
import Menu from "@/layouts/Menu.astro";
---

<Menu title="Menú público">
	<main class="mx-auto max-w-2xl px-6 py-12">
		<h1 class="text-2xl font-semibold tracking-tight">Menú público</h1>
		<p class="text-muted-foreground mt-2">
			Abrí <code class="text-sm">/m/{"{restaurant}"}</code> o{" "}
			<code class="text-sm">/m/{"{restaurant}"}/{"{menu}"}</code> (ej.{" "}
			<code class="text-sm">/m/seed-demo</code>).
		</p>
	</main>
</Menu>
