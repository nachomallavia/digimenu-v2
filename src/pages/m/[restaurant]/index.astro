---
/**
 * Restaurant entry: multi-menu shell (landing + menus) or single-menu render.
 * Legacy `?menu=` redirects to `/m/{restaurant}/{menu}`.
 */
import Menu from "@/layouts/Menu.astro";
import PublicMenu from "@/components/menu/PublicMenu.astro";
import {
	isPreparedPublicMenuPage,
	preparePublicMenuPage,
} from "@/lib/server/menu";

const prepared = await preparePublicMenuPage(Astro, { initialView: "landing" });
if (!isPreparedPublicMenuPage(prepared)) {
	return prepared;
}

const { loaded, viewModel, title, multiMenu, initialView } = prepared;
---

<Menu
	title={title}
	description={loaded.restaurant.description}
	restaurantSlug={loaded.restaurantSlug}
	theme={loaded.theme}
	brand={loaded.brand}
>
	<PublicMenu
		viewModel={viewModel}
		restaurant={multiMenu ? loaded.restaurant : undefined}
		theme={multiMenu ? loaded.theme : undefined}
		initialView={multiMenu ? initialView : "menu"}
	/>
</Menu>
