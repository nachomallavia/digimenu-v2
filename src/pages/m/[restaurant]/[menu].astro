---
/**
 * Direct menu route `/m/{restaurant}/{menu}`.
 */
import Menu from "@/layouts/Menu.astro";
import PublicMenu from "@/components/menu/PublicMenu.astro";
import {
	isPreparedPublicMenuPage,
	preparePublicMenuPage,
} from "@/lib/server/menu";

const menuSlug = Astro.params.menu;
const prepared = await preparePublicMenuPage(Astro, {
	menuSlug,
	initialView: "menu",
});
if (!isPreparedPublicMenuPage(prepared)) {
	return prepared;
}

const { loaded, viewModel, title, multiMenu } = prepared;
---

<Menu
	title={title}
	description={loaded.restaurant.description}
	restaurantSlug={loaded.restaurantSlug}
	theme={loaded.theme}
	brand={loaded.brand}
>
	<PublicMenu
		viewModel={viewModel}
		restaurant={multiMenu ? loaded.restaurant : undefined}
		theme={multiMenu ? loaded.theme : undefined}
		initialView="menu"
	/>
</Menu>
